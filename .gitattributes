* text=auto
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.mjs text eol=lf

# Files copied into Linux containers must keep LF endings (CRLF breaks shell shebangs).
docker/*.sh text eol=lf
docker/*.Dockerfile text eol=lf
docker/nginx.conf text eol=lf
