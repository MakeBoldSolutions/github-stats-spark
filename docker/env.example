# Copy to .env (git-ignored) for local use, or enter these as Portainer stack variables.
SPARK_USER=MakeBoldSolutions
# Refresh schedule (30m, 6h, 1d). The worker also collects once on start.
SPARK_REFRESH_INTERVAL=6h
SPARK_RUN_ON_START=true
# Local: 127.0.0.1 (default). Home server: 192.168.1.197
BIND_ADDRESS=127.0.0.1
WEB_PORT=8086
# Prefer GITHUB_TOKEN_FILE with a secret file; GITHUB_TOKEN is visible via `docker inspect`.
GITHUB_TOKEN=
GITHUB_TOKEN_FILE=
# Optional: enables AI summaries only if the command is extended with --include-ai-summaries.
ANTHROPIC_API_KEY=

# --- Admin UI (ps-004) ---
# First administrator, created on first start if none exists, then ignored.
# Remove SPARK_ADMIN_PASSWORD from the stack once you can sign in.
SPARK_ADMIN_USER=admin
SPARK_ADMIN_PASSWORD=
SPARK_ADMIN_PASSWORD_FILE=
# Encrypts tokens saved in the UI. Generate: docker compose run --rm api python -m spark.api generate-key
# Changing it makes previously saved tokens unreadable (re-enter them).
SPARK_SECRET_KEY=
SPARK_SECRET_KEY_FILE=
# Set true only when served over HTTPS.
SPARK_COOKIE_SECURE=false
