{
  "name": "github-stats-spark-dashboard",
  "version": "1.0.0",
  "description": "Interactive repository comparison dashboard for GitHub Stats Spark",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node --input-type=module -e \"import { clean } from './scripts/build-paths.mjs'; clean()\"",
    "lint": "eslint src --ext js,jsx --max-warnings 0",
    "lint:fix": "eslint src --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "prebuild": "npm run clean && npm run lint && npm run format:check",
    "build": "vite build",
    "postbuild": "node --input-type=module -e \"import { copyData } from './scripts/build-paths.mjs'; copyData()\"",
    "build:analyze": "npm run build -- --mode analyze",
    "preview": "vite preview --port 4173 --host",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run format:check && vitest run --coverage",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.2",
    "lucide-react": "^1.48.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-modal-sheet": "^5.6.0",
    "remark-gfm": "^4.0.1",
    "web-vitals": "^5.2.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.8.3",
    "puppeteer-core": "^25.12.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.48.0",
    "vite": "^8.0.14",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.0"
  }
}
